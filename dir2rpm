#!/usr/bin/env python3
"""Create an RPM from a staged filesystem tree: dir2rpm NAME VERSION STAGING_DIR."""
import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(description='Build an RPM from a DESTDIR installation tree')
    parser.add_argument('name')
    parser.add_argument('version')
    parser.add_argument('staging_dir', type=Path)
    parser.add_argument('--release', default='1')
    parser.add_argument('--summary', default='Locally packaged software')
    parser.add_argument('--license', default='Unknown')
    args = parser.parse_args()

    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.+~-]*', args.name):
        parser.error('Invalid RPM package name')
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.+~]*', args.version):
        parser.error('Invalid RPM version')
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.+~]*', args.release):
        parser.error('Invalid RPM release')
    if any('\n' in s or '\r' in s or '%' in s for s in (args.summary, args.license)):
        parser.error('Summary/license must not contain newlines or %')
    source = args.staging_dir.resolve()
    if not source.is_dir() or source.is_symlink():
        parser.error('Staging directory does not exist or is a symlink')
    if not shutil.which('rpmbuild'):
        parser.error('rpmbuild is missing; install rpm-build')

    # Do not claim ownership of common system directories. All other staged
    # directories, including empty ones, are explicitly owned via %dir.
    shared_dirs = {
        '/bin', '/sbin', '/lib', '/lib64', '/etc', '/opt', '/usr',
        '/usr/bin', '/usr/sbin', '/usr/lib', '/usr/lib64', '/usr/share',
        '/usr/local', '/usr/local/bin', '/usr/local/sbin',
        '/usr/local/lib', '/usr/local/lib64', '/usr/local/share',
        '/usr/local/etc', '/usr/local/include', '/usr/local/man',
        '/usr/local/share/man', '/var', '/var/lib', '/var/cache', '/var/log',
    }
    manifest = []
    for base, dirs, files in os.walk(source, topdown=True, followlinks=False):
        for entry in sorted(dirs + files):
            full = Path(base) / entry
            rel = '/' + full.relative_to(source).as_posix()
            if any(c in rel for c in ('\n', '\r', '"', '%', '\\')):
                parser.error(f'Unsupported special character in path: {rel!r}')
            if full.is_dir() and not full.is_symlink():
                if rel not in shared_dirs:
                    manifest.append(f'%dir "{rel}"')
            else:
                manifest.append(f'"{rel}"')
    if not manifest:
        parser.error('No packageable files or directories found')

    with tempfile.TemporaryDirectory(prefix='dir2rpm-') as tmp:
        top = Path(tmp)
        for d in ('BUILD', 'BUILDROOT', 'RPMS', 'SOURCES', 'SPECS', 'SRPMS'):
            (top / d).mkdir()
        staged = top / 'staged'
        shutil.copytree(source, staged, symlinks=True, copy_function=shutil.copy2)
        (top / 'manifest').write_text('\n'.join(manifest) + '\n', encoding='utf-8')
        spec = top / 'SPECS' / f'{args.name}.spec'
        # Paths are generated under a controlled temporary directory.
        spec.write_text(f'''Name: {args.name}
Version: {args.version}
Release: {args.release}
Summary: {args.summary}
License: {args.license}

%description
Files packaged from a staged installation tree.

%prep

%build

%install
mkdir -p "%{{buildroot}}"
cp -a "{staged}/." "%{{buildroot}}/"

%files -f {top / 'manifest'}
''', encoding='utf-8')
        cmd = ['rpmbuild', '--define', f'_topdir {top}', '-bb', str(spec)]
        subprocess.run(cmd, check=True)
        rpms = sorted((top / 'RPMS').rglob('*.rpm'))
        if not rpms:
            raise RuntimeError('rpmbuild completed but no RPM was found')
        for rpm in rpms:
            dest = Path.cwd() / rpm.name
            if dest.exists():
                raise FileExistsError(f'Output already exists: {dest}')
            shutil.copy2(rpm, dest)
            print(f'Created: {dest}')


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.CalledProcessError, RuntimeError) as exc:
        print(f'dir2rpm: {exc}', file=sys.stderr)
        sys.exit(1)
